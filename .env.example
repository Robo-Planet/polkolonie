# Kopiuj do .env.local (lokalnie) lub ustaw w Vercel. NIGDY nie commituj prawdziwych wartości.
# Izolacja: nie wpisuj tu żadnych zmiennych z aplikacji zapisy.roboplanet.pl.

# Baza półkolonii (Neon, osobny projekt). Lokalnie: lokalny PostgreSQL.
DATABASE_URL="postgresql://polkolonie:CHANGE_ME@localhost:5432/polkolonie_dev"

# Publiczny adres aplikacji (do linków w e-mailach)
APP_URL="http://localhost:3000"

# Sekret podpisu sesji administratora (min. 32 znaki)
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"

# Klucz szyfrowania danych wrażliwych (32 bajty w base64): openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# Poczta. MAIL_TRANSPORT=log wypisuje e-maile w konsoli (tylko lokalnie).
MAIL_TRANSPORT="log"
MAIL_FROM="ROBOPLANET EVENTS S.C. <polkolonie@roboplanet.pl>"
# Osobny użytkownik SMTP tej aplikacji (nie konto zapisów):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
