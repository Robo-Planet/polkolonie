// Schemat bazy półkolonii RoboPlanet (wg specyfikacji, sekcja "Model danych").
// Etap 1 (Fundament): Organizer, Turnus, Application, Event, AdminUser, Counter, RateLimit.
// Modele Charge, BankTransaction, Allocation, Document, Signature dojdą w etapach 2–3.
//
// Konwencje: kwoty w groszach (Int), daty turnusu jako DATE (północ UTC),
// znaczniki czasu jako DateTime (UTC), identyfikatory cuid.

generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  ZGLOSZONE       // krótkie zgłoszenie (formularz na stronie)
  UMOWA_ZAWARTA   // umowa zawarta (czeka na zaliczkę)
  MIEJSCE         // ma miejsce (po wpłaceniu zaliczki)
  KWALIFIKACJA    // karta przyjęta przez biuro
  OPLACONE        // dopłata wpłacona
  ODMOWA          // odmowa kwalifikacji (zwrot wpłat)
  WYGASLA         // wygasła (brak zaliczki / decyzja biura)
  REZERWA         // lista rezerwowa (brak miejsc)
}

// Organizator – jeden rekord (id = 1).
model Organizer {
  id          Int      @id @default(1)
  name        String   // ROBOPLANET EVENTS S.C.
  nip         String
  street      String
  postalCode  String   // NN-NNN
  city        String
  bankName    String   // Erste
  bankAccount String   // numer konta do przelewów
  regon       String?  // REGON (umowa)
  representative String? // osoba reprezentująca (umowa)
  phone       String?
  email       String?
  updatedAt   DateTime @updatedAt
}

model Turnus {
  id           String   @id @default(cuid())
  number       String   // "I", "II", ...
  season       String   // kod sezonu, np. "Z27" (ferie zimowe 2027)
  startDate    DateTime @db.Date // pierwszy dzień, północ UTC
  endDate      DateTime @db.Date // ostatni dzień, północ UTC
  hoursFrom    String   // "07:45"
  hoursTo      String   // "16:30"
  venue        String   // adres miejsca wypoczynku
  placeLimit   Int      // limit miejsc
  minAge       Int      @default(6)
  priceGrosze  Int      // cena turnusu w groszach
  depositGrosze Int     @default(20000) // zaliczka 200 zł
  discountGrosze Int    @default(5000)  // zniżka stałego uczestnika 50 zł
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]

  @@unique([season, number])
}

model Application {
  id                   String            @id @default(cuid())
  code                 String            @unique // np. RP-Z27-0142
  turnusId             String
  turnus               Turnus            @relation(fields: [turnusId], references: [id])
  status               ApplicationStatus @default(ZGLOSZONE)
  statusChangedAt      DateTime          @default(now())

  // Krótkie zgłoszenie
  parentFirstName      String
  parentLastName       String
  parentEmail          String
  parentPhone          String
  childFirstName       String
  returningParticipant Boolean           @default(false) // uczestnik zajęć / poprzednich edycji
  rodoConsentAt        DateTime

  // Pełny formularz (etap 2). Dane wrażliwe (PESEL, zdrowie, osoby do odbioru) szyfrowane.
  childLastName        String?
  secondParentName     String?
  parentPhoneAlt       String?
  parentAddress        String?
  parentPostalCode     String?
  parentCity           String?
  childSameAddress     Boolean           @default(false)
  childAddress         String?
  childPostalCode      String?
  childCity            String?
  peselEnc             String?           // PESEL dziecka, zaszyfrowany
  parentPeselEnc       String?           // PESEL osoby zawierającej umowę, zaszyfrowany
  contractTemplateVersion Int?           // wersja wzoru umowy, którą zawarto
  contractTemplateSha256  String?        // SHA-256 wzoru umowy (wersja pliku)
  healthEnc            String?           // JSON: zdrowie i osoby do odbioru, zaszyfrowany
  selfReturn           Boolean?          // zgoda na samodzielny powrót
  pickupTime           String?           // godzina przyprowadzania i odbioru
  photoConsent         Boolean           @default(false)
  marketingPhotoConsent Boolean          @default(false)
  regulaminAcceptedAt  DateTime?
  healthConsentAt      DateTime?
  draftSavedAt         DateTime?
  formSubmittedAt      DateTime?
  contractSignedAt     DateTime?         // data zawarcia umowy (podpis)
  contractSignatureSha256 String?        // SHA-256 podpisanej umowy
  summaryAckAt         DateTime?         // potwierdzenie zapoznania się z podsumowaniem (przed podpisem)

  // Potwierdzenie adresu e-mail (kliknięcie linku)
  emailConfirmedAt     DateTime?

  // Link do pełnego formularza: w bazie tylko skrót tokenu
  linkTokenHash        String            @unique
  linkExpiresAt        DateTime

  // Kwoty i lista rezerwowa
  discountGrosze       Int               @default(0)
  waitlistPosition     Int?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  events               Event[]
  charges              Charge[]
  signCodes            SignCode[]
  signature            Signature?
  documents            Document[]

  @@index([turnusId, status])
}

// Dziennik zdarzeń: każda zmiana zgłoszenia lub konfiguracji.
model Event {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  actor         String       // "system", "rodzic" albo e-mail administratora
  action        String       // np. "application.created"
  before        Json?
  after         Json?
  note          String?
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
}

// Jedno konto administratora (bez innych ról).
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    // bcrypt
  totpSecretEnc   String    // sekret TOTP, zaszyfrowany kluczem aplikacji
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Licznik numeracji kodów zgłoszeń (atomowy inkrement).
model Counter {
  key   String @id
  value Int    @default(0)
}

// Dławienie prób (logowanie, formularze publiczne): okno czasowe i liczba prób.
model RateLimit {
  key         String   @id // np. "login:email:..." (skrót)
  count       Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?
}

enum ChargeKind {
  ZALICZKA // zaliczka 200 zł, 7 dni od zawarcia umowy
  DOPLATA  // cena − zniżka − zaliczka, 14 dni przed startem
  CALOSC   // późny zapis: cała kwota w 3 dni
}

// Należność: jedna na zgłoszenie i rodzaj.
model Charge {
  id             String       @id @default(cuid())
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id])
  kind           ChargeKind
  amountGrosze   Int
  paidGrosze     Int          @default(0)
  dueDate        DateTime     @db.Date
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  allocations    Allocation[]

  @@unique([applicationId, kind])
}

enum BankSource {
  ALERT  // alert Alerty24 (e-mail)
  CSV    // import z Erste
  MANUAL // ręczne oznaczenie przez biuro
}

enum MatchStatus {
  UNMATCHED // brak zgłoszenia – do wyjaśnienia
  PARTIAL   // przypisana część (np. nadpłata)
  MATCHED   // w pełni przypisana
}

// Wpływ z banku. Saldo z alertu nie jest zapisywane.
model BankTransaction {
  id               String       @id @default(cuid())
  source           BankSource
  dedupeKey        String       @unique // np. "alert:<identyfikator>"
  bookedAt         DateTime
  amountGrosze     Int
  title            String
  senderName       String
  recipientAccount String
  messageId        String?
  matchStatus      MatchStatus  @default(UNMATCHED)
  applicationId    String?      // zgłoszenie wskazane przez kod w tytule lub przez biuro
  createdAt        DateTime     @default(now())
  allocations      Allocation[]

  @@index([matchStatus])
}

model Allocation {
  id             String          @id @default(cuid())
  transactionId  String
  transaction    BankTransaction @relation(fields: [transactionId], references: [id])
  chargeId       String
  charge         Charge          @relation(fields: [chargeId], references: [id])
  amountGrosze   Int
  createdAt      DateTime        @default(now())
}

// Kod potwierdzający podpis (wysyłany e-mailem). W bazie tylko skrót; 10 minut ważności, limit prób.
model SignCode {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])
  codeHash       String
  expiresAt      DateTime
  attempts       Int         @default(0)
  consumedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@index([applicationId, createdAt])
}

// Dowód podpisu (podpis na ekranie): czas, IP, przeglądarka, potwierdzenie kodu, skrót PDF.
model Signature {
  id               String      @id @default(cuid())
  applicationId    String      @unique
  application      Application @relation(fields: [applicationId], references: [id])
  method           String      // SCREEN (podpis na ekranie) | TRUSTED (podpis zaufany) | PRINT (wydruk)
  signedAt         DateTime
  ip               String?
  userAgent        String?
  codeConfirmedAt  DateTime?
  pdfSha256        String
  kartaSha256      String?      // SHA-256 podpisanej karty kwalifikacyjnej
  signatureImageEnc String     // obraz podpisu (PNG), zaszyfrowany
  templateVersion  Int
}

// Dokument zawarty w zgłoszeniu (umowa podpisana). Plik trzymany w bazie do czasu archiwum w pCloud.
model Document {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])
  kind           String      // UMOWA_PODPISANA
  templateVersion Int
  sha256         String
  bytes          Bytes
  createdAt      DateTime    @default(now())

  @@unique([applicationId, kind])
}
